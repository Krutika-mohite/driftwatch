# Copy this file to .env and adjust.  (.env is never committed to Git.)

# --- SQL Server connection ---
# Default instance:            localhost
# Named Express instance:      localhost\SQLEXPRESS

# --- Pipeline ---
DW_TABLES=customers,products,orders
DW_CHUNK_SIZE=5000
DW_MAX_RETRIES=3
#DW_SQL_SERVER=SCSMP-94\SQLEXPRESS
DW_SQL_SERVER=.\SQLEXPRESS
DW_SQL_DATABASE=DriftwatchSource
DW_SQL_DRIVER=ODBC Driver 18 for SQL Server
DW_SQL_TRUSTED=yes